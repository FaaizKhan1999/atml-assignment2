\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Controlled Diagnostic Perturbation Response Distributions. Diagnostic response distributions across 20 GSM8K test problems (80 evaluated pairs) under four controlled perturbation conditions (Reasoning Corruption, Outcome Error, Persuasive Filler, Gold Distractor), comparing rule-based Exact Verifier evaluations against Pairwise AI Judge decisions. The deterministic verifier is sensitive to final outcome errors ($S_{\text  {outcome}} = 1.0$) and distractors, but blind to reasoning invalidity ($S_{\text  {reason}} = 0.0$), whereas the AI judge ties on outcome-corrupted completions and prefers verbose filler in 25.0\% of pairs.}}{24}{figure.caption.55}\protected@file@percent }
\newlabel{fig:task5_perturbations}{{7}{24}{Controlled Diagnostic Perturbation Response Distributions. Diagnostic response distributions across 20 GSM8K test problems (80 evaluated pairs) under four controlled perturbation conditions (Reasoning Corruption, Outcome Error, Persuasive Filler, Gold Distractor), comparing rule-based Exact Verifier evaluations against Pairwise AI Judge decisions. The deterministic verifier is sensitive to final outcome errors ($S_{\text {outcome}} = 1.0$) and distractors, but blind to reasoning invalidity ($S_{\text {reason}} = 0.0$), whereas the AI judge ties on outcome-corrupted completions and prefers verbose filler in 25.0\% of pairs}{figure.caption.55}{}}
