\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces GRPO group informativeness scaling across candidate group sizes $K \in \{2, 4, 8\}$ under an equal generation budget of 192 completions. Groups are stratified by initial prompt difficulty into Easy and Hard tiers ($\tau = 2.1987$). While scaling from $K=2$ to $K=4$ increases informative group coverage from 93.8\% to 95.8\% and attains 100\% informativeness on easy prompts, hard prompts plateau at 91.7\% for both $K=4$ and $K=8$. This shows that increasing group size plateaus on hard prompts where completions receive identical rewards.}}{19}{figure.caption.48}\protected@file@percent }
\newlabel{fig:grpo_informativeness}{{5}{19}{GRPO group informativeness scaling across candidate group sizes $K \in \{2, 4, 8\}$ under an equal generation budget of 192 completions. Groups are stratified by initial prompt difficulty into Easy and Hard tiers ($\tau = 2.1987$). While scaling from $K=2$ to $K=4$ increases informative group coverage from 93.8\% to 95.8\% and attains 100\% informativeness on easy prompts, hard prompts plateau at 91.7\% for both $K=4$ and $K=8$. This shows that increasing group size plateaus on hard prompts where completions receive identical rewards}{figure.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Standard GRPO continuation dynamics over 20 update steps on \texttt  {rl\_prompt\_pool\_train}. Panels track (a) policy reward, (b) reference policy token KL divergence ($\times 10^{-5}$ nats), (c) within-group reward standard deviation ($\bar  {s}_r$), (d) policy loss, (e) policy gradient norm, (f) token entropy, (g) mean response length against the 512 token cap, and (h) candidate group size ($K$) scaling informativeness. Vertical shaded bands mark no-op updates 5, 13, 15, and 17 where all four completions reached the 512-token cap and produced zero gradients. Operational profile: peak VRAM 8.59 GiB, total wall-clock time 451.3 s ($\approx 22.6$ s per update).}}{19}{figure.caption.49}\protected@file@percent }
\newlabel{fig:grpo_trajectories}{{6}{19}{Standard GRPO continuation dynamics over 20 update steps on \texttt {rl\_prompt\_pool\_train}. Panels track (a) policy reward, (b) reference policy token KL divergence ($\times 10^{-5}$ nats), (c) within-group reward standard deviation ($\bar {s}_r$), (d) policy loss, (e) policy gradient norm, (f) token entropy, (g) mean response length against the 512 token cap, and (h) candidate group size ($K$) scaling informativeness. Vertical shaded bands mark no-op updates 5, 13, 15, and 17 where all four completions reached the 512-token cap and produced zero gradients. Operational profile: peak VRAM 8.59 GiB, total wall-clock time 451.3 s ($\approx 22.6$ s per update)}{figure.caption.49}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Complete step-by-step optimization telemetry for the standard GRPO continuation run (20 updates). Updates 5, 13, 15, and 17 hit the 512-token cap on all completions and were masked out, producing exactly zero gradient norm, policy loss, KL divergence, and entropy despite non-zero reward variance.}}{20}{table.caption.50}\protected@file@percent }
